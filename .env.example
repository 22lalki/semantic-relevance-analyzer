# All optional. With none of these set the app still runs end to end:
# lexical scoring + a clearly-labelled demo AI analysis.

# Live "Deep AI Semantic Analysis" and Claude-generated Semantic Context.
ANTHROPIC_API_KEY=
# Override the analysis model (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=

# Embedding-based scoring mode. Any OpenAI-compatible /embeddings endpoint.
EMBEDDINGS_API_KEY=
EMBEDDINGS_API_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
